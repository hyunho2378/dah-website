# DAH 프론트(Vite) 환경변수. 실제 값은 client/.env에 두고 커밋 금지(.gitignore 처리됨).
# 이관 시: 아래 값만 새 API 서버 주소로 교체하면 됨(코드 수정 불필요).

# API 서버(Render) 주소.
#   로컬=http://localhost:4000, 배포=https://<your-render-service>.onrender.com
# Vite는 빌드 시점에 값을 인라인하므로, 값 변경 후 반드시 재빌드/재배포해야 반영됨.
VITE_API_URL=http://localhost:4000

# 이 사이트 자신의 공개 주소(프로토콜 포함, 끝 슬래시 없음).
#   예: https://dah-website.vercel.app 또는 https://dah.hallym.ac.kr
# 용도: index.html의 og:url·og:image·canonical을 https 절대 URL로 만든다.
#   카카오톡 등 공유 크롤러는 상대경로를 읽지 못하므로 배포 환경에는 반드시 설정해야 한다.
#   미설정 시 상대경로로 남고(사이트 동작엔 문제 없음) 빌드 로그에 경고가 출력된다.
VITE_SITE_URL=
